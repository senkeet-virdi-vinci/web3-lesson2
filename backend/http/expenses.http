@server = http://localhost:3000
@expenses = {{server}}/api/expenses

### Get all expenses
GET {{expenses}}

### Add a new expense
POST {{expenses}}
Content-Type: application/json

{
  "date": "2025-11-30T00:00:00Z",
  "description": "Team lunch 3",
  "payerId": 2,
  "amount": 25.55
}

### Reset expenses
POST {{expenses}}/reset

### Expenses where amount >= 30
GET {{expenses}}?amount=30

### Expenses where amount is invalid
GET {{expenses}}?amount=abc

### Expenses by payer
GET {{expenses}}?payerId=14

### Expenses by payer and amount
GET {{expenses}}?payerId=15&amount=30

### Invalid payerId (400 attendu)
GET {{expenses}}?payerId=abc


### Expenses by category
GET {{expenses}}?categoryId=1

### Category + payer + amount
GET {{expenses}}?categoryId=1&payerId=2&amount=10

### Invalid categoryId (400 attendu)
GET {{expenses}}?categoryId=abc


### Get an expense by its id
GET {{expenses}}/4

### Get an expense by its id (404)
GET {{expenses}}/9999

