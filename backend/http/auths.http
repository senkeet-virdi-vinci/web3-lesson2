@server = http://localhost:3000
@auth = {{server}}/api/auth

### Register (201 attendu)
# @name register
POST {{auth}}/register
Content-Type: application/json

{
  "name": "Test User",
  "email": "test@example.com",
  "password": "topsecret123"
}

### Register avec le même email (409 attendu)
POST {{auth}}/register
Content-Type: application/json

{
  "name": "Test User",
  "email": "test@example.com",
  "password": "topsecret123"
}

### Register avec un mot de passe trop court (400 attendu)
POST {{auth}}/register
Content-Type: application/json

{
  "name": "Short",
  "email": "short@example.com",
  "password": "abc"
}

### Login (200 attendu, renvoie token + user)
# @name login
POST {{auth}}/login
Content-Type: application/json

{
  "email": "alice@gmail.com",
  "password": "topsecret"
}

### Login avec un mauvais mot de passe (401 attendu)
POST {{auth}}/login
Content-Type: application/json

{
  "email": "alice@gmail.com",
  "password": "wrongpassword"
}

### Login avec un email inconnu (401 attendu, même message que ci-dessus)
POST {{auth}}/login
Content-Type: application/json

{
  "email": "nobody@example.com",
  "password": "topsecret"
}

### Login avec un email invalide (401 attendu)
POST {{auth}}/login
Content-Type: application/json

{
  "email": "pas-un-email",
  "password": "topsecret"
}